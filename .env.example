# 4 앱 공용 환경변수 이름 표 — 복사해서 루트 .env.local 로 (apps/*/svelte.config.js 의 kit.env.dir '../..' 가 이 폴더를 읽는다).
# 값은 여기·코드·PR 어디에도 쓰지 않는다 — .env.local(gitignored) 과 Vercel 프로젝트 환경변수에만 (docs/monorepo-migration.md §1.2).
#
# PUBLIC_* 는 $env/static/public (빌드 시 인라인). 아래 두 줄은 값이 비어 있어도 되지만 이름이 없으면
# svelte-check(`npm run check`)·vite build 가 "not exported by $env/static/public" 으로 실패한다. CI 는 더미 값을 넣는다(.github/workflows/ci.yml).
# 비어 있으면 hooks.server.ts 가 Supabase 없이 통과한다(locals.supabase = null) — 데모 앱 4개는 키 없이 뜬다.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# S2 부터 apps/shop 이 절대 URL(og · canonical · 메일 링크)에 쓴다 — 비어 있으면 http://localhost:5176. 이름은 있어야 한다(위와 같은 이유). 예 https://sellery.life
PUBLIC_SITE_URL=
# S3 apps/shop 체크아웃 — 토스 결제위젯 클라이언트 키(test_gck_/live_gck_, 시크릿 키와 짝). $env/static/public 이라 이름은 있어야 한다(CI 는 test_gck_ci 더미).
PUBLIC_TOSS_CLIENT_KEY=
# 선택($env/dynamic/public — 없어도 된다): 결제위젯 UI variantKey (기본 DEFAULT-2) · 개발용 이메일 로그인 폼(=1 이고 dev 일 때만 /login 에 렌더)
# PUBLIC_TOSS_WIDGET_VARIANT=
# PUBLIC_DEV_LOGIN=

# ---- 서버 비밀 (런타임 $env/dynamic/private — 빌드에 불필요, CI 에 넣지 않는다). S3(shop 체크아웃·결제) · S5(콘솔) 의 hooks.server.ts 가 읽어
#      @sellery/db 의 configureDb() · @sellery/payments 의 configurePayments() 로 패키지에 주입한다 (docs/monorepo-migration.md §2.1 · §3).
#      shop(S3) · influencer(S5) 의 hooks 가 읽는다. 어디서 얻는지는 docs/deploy.md §1.2 · §5 (Vercel 값과 같은 이름).
# SUPABASE_SERVICE_ROLE_KEY=      service role — RLS 우회 (createAdminClient)
# TOSS_SECRET_KEY=                토스 시크릿 (결제위젯 키 짝 test_gsk_/live_gsk_)
# SLACK_WEBHOOK_URL=              선택 — 가입·채널 인증 알림 한 줄
# CRON_SECRET=                    /api/cron/reconcile Bearer
