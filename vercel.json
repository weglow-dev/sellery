{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "npm ci",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"rewrites": [
		{ "source": "/influencer/:path*", "destination": "/influencer/index.html" },
		{ "source": "/brand/:path*", "destination": "/brand/index.html" },
		{ "source": "/admin/:path*", "destination": "/admin/index.html" },
		{ "source": "/shop/:path*", "destination": "/shop/index.html" }
	],
	"headers": [
		{ "source": "/(influencer|brand|admin|shop)/_app/immutable/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
	]
}
