{
  "name": "sellery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:influencer": "npm run dev -w apps/influencer",
    "dev:brand": "npm run dev -w apps/brand",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:shop": "npm run dev -w apps/shop",
    "check": "npm run check --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "gen:types": "npm run gen:types -w packages/db",
    "build": "npm run build --workspaces --if-present",
    "build:apps": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
