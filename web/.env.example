# sellery-web — environment template. Copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real keys. 값은 docs/app-plan.md §3 의 표에서 얻는다.

# Supabase — project sellery (ref ocxppeuoiysnkwwujvko)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. All writes go through this.
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments — 결제위젯 전용 키 짝 (gck/gsk). MID NHN_shingoonk
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# SERVER ONLY
TOSS_SECRET_KEY=
# 결제수단 위젯 UI 변형 이름 (상점관리자 → 결제위젯). 비우면 DEFAULT-2
NEXT_PUBLIC_TOSS_WIDGET_VARIANT=

# Absolute site URL (metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# reconcile 잡 수동 호출 (/api/cron/reconcile, Authorization: Bearer …) — 임의 생성. 슬라이스 1 은 크론 없음 (§7.5)
CRON_SECRET=

# 파트너 콘솔 호스트 (docs/inf-console-plan.md §2.3 · src/lib/hosts.ts). 비우면 경로 모드 — /influencer/* 를 직접 연다(Preview·로컬 기본).
# Production 에만 inf.sellery.life 를 넣는다. 값은 host 만(스킴·경로 없이) — proxy 가 Host 헤더와 소문자 정확 일치로 비교한다.
# 로컬 호스트 모드 검증: inf.localhost:3000 (next.config.ts allowedDevOrigins) → http://inf.localhost:3000
NEXT_PUBLIC_INF_HOST=
# 브랜드 콘솔(다음) — brand.sellery.life. 지금은 비워 둔다.
NEXT_PUBLIC_BRAND_HOST=

# (선택) Slack Incoming Webhook — 인플루언서 가입 완료 · 채널 [인증 확인] · 정지/복귀 · 채널 인증 완료를 한 줄씩 알린다
# (docs/inf-console-plan.md §4.3 · §2.3). 본문은 seller/channel code · 활동명 · 플랫폼만 — 이메일·핸들·URL 은 넣지 않는다. 비우면 무시.
SLACK_WEBHOOK_URL=
