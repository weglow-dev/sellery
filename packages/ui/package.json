{
  "name": "@sellery/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./site": {
